# Anthropic Claude API Key for the portfolio AI assistant
# When set, /api/assistant calls Claude to answer visitor questions grounded in content.ts.
# When unset or omitted, the assistant operates in Demo Mode using keyword matching.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Override the model (defaults to claude-sonnet-5-5 or claude-3-5-sonnet-20241022)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
